---
import AppLayout from '../../layouts/AppLayout.astro';
import OrbitalHtmlEditor from '../../components/orbital-html-editor/OrbitalHtmlEditor.astro';
import { apiUrl } from '../../config/api-url';
const moduleBase = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<AppLayout title="Nova campanha">
  <section class="page-head campaign-page-head">
    <div><h1>Nova campanha</h1></div>
  </section>
  <div id="message" class="message" hidden></div>
  <form id="campaignForm" class="card campaign-form campaign-form-two-columns">
    <section class="campaign-column campaign-data-column" aria-labelledby="campaign-data-title">
      <div class="form-section-head">
        <h2 id="campaign-data-title">Dados da campanha</h2>
        <p>Assunto e situação.</p>
      </div>

      <div class="dev-only dev-highlight dev-field-group"><label>Nome interno <span>*</span><input name="internal_name" maxlength="255" /></label></div>
      <label>Assunto <span>*</span><input name="subject" maxlength="500" required /></label>
      <div class="dev-only dev-highlight dev-field-group">
        <label>Nome do remetente <span>*</span><input name="sender_name" maxlength="255" /></label>
        <label>E-mail do remetente <span>*</span><input name="sender_email" type="email" maxlength="255" /></label>
        <label>Responder para<input name="reply_to" type="email" maxlength="255" /></label>
      </div>
      <label>Status<select name="status"><option value="draft">Rascunho</option><option value="ready">Pronta</option></select></label>
    </section>

    <section class="campaign-column campaign-content-column" aria-labelledby="campaign-content-title">
      <div class="form-section-head">
        <h2 id="campaign-content-title">Conteúdo</h2>
        <p>Conteúdo HTML do e-mail.</p>
      </div>

      <div class="html-field"><OrbitalHtmlEditor name="body_html" id="bodyHtmlEditor" uploadUrl={`${apiUrl}/images`} minHeight="390px" /></div>
      <div class="dev-only dev-highlight dev-field-group"><label class="text-field">Texto simples<textarea name="body_text" rows="5"></textarea></label></div>
    </section>

    <div class="form-actions form-actions-full">
      <a class="button secondary" href={`${moduleBase}/campanhas`}>Cancelar</a>
      <button class="button" type="submit">Salvar campanha</button>
    </div>
  </form>
</AppLayout>
<script is:inline define:vars={{ apiUrl, moduleBase }}>
  const form = document.querySelector('#campaignForm');
  const message = document.querySelector('#message');
  const apiErrors = window.OrbitalApiErrors;
  function showMessage(text, type='error'){message.hidden=false;message.className=`message ${type}`;message.textContent=text;}
  form.addEventListener('submit', async event => {
    event.preventDefault();
    const submit = form.querySelector('button[type="submit"]');
    submit.disabled = true;
    message.hidden = true;
    const data = Object.fromEntries(new FormData(form));
    for (const field of ['internal_name', 'sender_name', 'sender_email', 'reply_to', 'body_html', 'body_text']) data[field] = data[field] || null;
    try {
      const response = await fetch(`${apiUrl}/campaigns`, {method:'POST',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
      if (!response.ok) throw new Error(await apiErrors.fromResponse(response, 'Não foi possível salvar a campanha.'));
      window.location.href = `${moduleBase}/campanhas?saved=1`;
    } catch(error){showMessage(apiErrors.fromException(error, 'Não foi possível salvar a campanha.'));submit.disabled=false;}
  });
</script>
