---
import AppLayout from '../../layouts/AppLayout.astro';
import OrbitalHtmlEditor from '../../components/orbital-html-editor/OrbitalHtmlEditor.astro';
import { apiUrl } from '../../config/api-url';
const { id } = Astro.params;
---
<AppLayout title="Editar campanha">
  <section class="page-head campaign-page-head">
    <div><h1>Editar campanha</h1><p>Altere os dados e o conteúdo salvos no Oracle.</p></div>
  </section>
  <div id="message" class="message" hidden></div>
  <form id="campaignForm" class="card campaign-form campaign-form-two-columns">
    <section class="campaign-column campaign-data-column" aria-labelledby="campaign-data-title">
      <div class="form-section-head">
        <h2 id="campaign-data-title">Dados da campanha</h2>
        <p>Identificação, remetente e situação.</p>
      </div>

      <label>Nome interno <span>*</span><input name="internal_name" maxlength="255" required /></label>
      <label>Assunto <span>*</span><input name="subject" maxlength="500" required /></label>
      <label>Nome do remetente <span>*</span><input name="sender_name" maxlength="255" required /></label>
      <label>E-mail do remetente <span>*</span><input name="sender_email" type="email" maxlength="255" required /></label>
      <label>Responder para<input name="reply_to" type="email" maxlength="255" /></label>
      <label>Status<select name="status"><option value="draft">Rascunho</option><option value="ready">Pronta</option><option value="paused">Pausada</option><option value="error">Erro</option></select></label>
    </section>

    <section class="campaign-column campaign-content-column" aria-labelledby="campaign-content-title">
      <div class="form-section-head">
        <h2 id="campaign-content-title">Conteúdo</h2>
        <p>HTML principal e versão alternativa em texto.</p>
      </div>

      <div class="html-field"><OrbitalHtmlEditor name="body_html" id="bodyHtmlEditor" uploadUrl={`${apiUrl}/images`} minHeight="390px" /></div>
      <label class="text-field">Texto simples<textarea name="body_text" rows="5"></textarea></label>
    </section>

    <div class="form-actions form-actions-full">
      <a class="button secondary" href="/campanhas">Voltar</a>
      <button class="button" type="submit">Salvar alterações</button>
    </div>
  </form>
</AppLayout>
<script define:vars={{ apiUrl, id }}>
  const form = document.querySelector('#campaignForm');
  const message = document.querySelector('#message');
  function showMessage(text,type='error'){message.hidden=false;message.className=`message ${type}`;message.textContent=text;}
  async function load(){
    try{
      const response=await fetch(`${apiUrl}/campaigns/${id}`, {credentials:'include'});
      const data=await response.json().catch(()=>({}));
      if(!response.ok) throw new Error(data.detail || 'Campanha não encontrada.');
      for(const [key,value] of Object.entries(data)){if(form.elements[key]) form.elements[key].value=value ?? '';}
      const editor=document.querySelector('#bodyHtmlEditor');if(editor) editor.value=data.body_html ?? '';
      if(new URLSearchParams(location.search).has('saved')) showMessage('Campanha salva no banco.','success');
    }catch(error){showMessage(error.message);form.querySelectorAll('input,textarea,select,button').forEach(el=>el.disabled=true);document.querySelector('#bodyHtmlEditor')?.querySelectorAll('button').forEach(el=>el.disabled=true);}
  }
  form.addEventListener('submit',async event=>{
    event.preventDefault();
    const submit=form.querySelector('button[type="submit"]');submit.disabled=true;
    const data=Object.fromEntries(new FormData(form));
    data.reply_to=data.reply_to||null;data.body_html=data.body_html||null;data.body_text=data.body_text||null;
    try{
      const response=await fetch(`${apiUrl}/campaigns/${id}`,{method:'PUT',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});
      const result=await response.json().catch(()=>({}));
      if(!response.ok) throw new Error(result.detail?.[0]?.msg || result.detail || 'Não foi possível salvar.');
      window.location.href='/campanhas?saved=updated';
    }catch(error){showMessage(error.message);}finally{submit.disabled=false;}
  });
  load();
</script>
