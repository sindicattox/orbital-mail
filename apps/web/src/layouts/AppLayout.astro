---
import { OrbitalSidebar, OrbitalTopBar } from '@orbital/ui';
import '@orbital/ui/tokens.css';
import '../styles/global.css';
import '../styles/ui.css';
import { apiUrl } from '../config/api-url';
import orbitalMailAuthScript from '../assets/auth/orbital-mail-auth.js?raw';

interface Props { title: string; description?: string; devOnly?: boolean; }
const { title, description = '', devOnly = false } = Astro.props;
const moduleBase = import.meta.env.BASE_URL.replace(/\/$/, '');

const mailItems = [
  { id: 'overview', label: 'Visão geral', href: `${moduleBase}/`, exact: true, badge: 'VG' },
  { id: 'campaigns', label: 'Campanhas', href: `${moduleBase}/campanhas`, badge: 'CA' },
  { id: 'dispatch-queue', label: 'Fila de envios', href: `${moduleBase}/fila-envios`, badge: 'FE' },
  { id: 'lists', label: 'Listas', href: `${moduleBase}/listas`, disabled: true, badge: 'LI' },
  { id: 'templates', label: 'Modelos', href: `${moduleBase}/modelos`, badge: 'MO' },
  { id: 'test-send', label: 'Teste de envio', href: `${moduleBase}/teste-envio`, badge: 'TE' },
];
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <title>{title} · Orbital Mail</title>
  <script is:inline src={`${moduleBase}/scripts/api-errors.js`}></script>
</head>
<body
  data-api-url={apiUrl}
  data-orbital-home-url={import.meta.env.PUBLIC_ORBITAL_HOME_URL || '/'}
  data-module-base={moduleBase}
  data-dev-only-page={devOnly ? 'true' : undefined}
>
  <div class="app-shell">
    <OrbitalTopBar
      brandHref={import.meta.env.PUBLIC_ORBITAL_HOME_URL || '/'}
      moduleLabel="Mail"
    />
    <div class="app-workspace">
      <OrbitalSidebar
        moduleLabel="Mail"
        items={mailItems}
        ariaLabel="Navegação do Orbital Mail"
      />
      <main class:list={["app-main", { "dev-only": devOnly, "dev-highlight-page": devOnly }]}><slot /></main>
    </div>
  </div>
  <script is:inline set:html={orbitalMailAuthScript}></script>
</body>
</html>
