---
import { OrbitalSidebar, OrbitalTopBar } from '@orbital/ui';
import '@orbital/ui/tokens.css';
import authGuardSource from '@orbital/ui/auth-guard.js?raw';
import '../styles/global.css';
import '../styles/ui.css';
import '@orbital/ui/base.css';
import { apiUrl } from '../config/api-url';
import orbitalMailAuthScript from '../assets/auth/orbital-mail-auth.js?raw';

interface Props { title: string; description?: string; devOnly?: boolean; }
const { title, description = '', devOnly = false } = Astro.props;
const moduleBase = import.meta.env.BASE_URL.replace(/\/$/, '');

const mailItems = [
  { id: 'overview', label: 'Visão geral', href: `${moduleBase}/`, exact: true },
  { id: 'campaigns', label: 'Campanhas', href: `${moduleBase}/campanhas` },
  { id: 'dispatch-queue', label: 'Fila de envios', href: `${moduleBase}/fila-envios`, devOnly: true },
  { id: 'test-send', label: 'Teste de envio', href: `${moduleBase}/teste-envio`, devOnly: true },
  { id: 'settings', label: 'Configurações', href: `${moduleBase}/configuracoes`, devOnly: true },
];
---
<!doctype html>
<html lang="pt-BR" data-orbital-protected data-auth-api={apiUrl} data-auth-path="/auth/context" data-module-label="Mail" data-orbital-dev-required={devOnly ? 'true' : undefined}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <title>{title} · Orbital Mail</title>
  <style is:inline>
    html[data-orbital-protected]:not([data-orbital-auth="authenticated"]):not([data-orbital-auth="blocked"]) body { visibility: hidden; }
  </style>
  <script is:inline set:html={authGuardSource}></script>
  <script is:inline src={`${moduleBase}/scripts/api-errors.js`}></script>
</head>
<body
  data-api-url={apiUrl}
  data-orbital-home-url={import.meta.env.PUBLIC_ORBITAL_HOME_URL || '/'}
  data-module-base={moduleBase}
>
  <div class="app-shell">
    <OrbitalTopBar
      brandHref={import.meta.env.PUBLIC_ORBITAL_HOME_URL || '/'}
      moduleLabel="Mail"
    />
    <div class="app-workspace">
      <OrbitalSidebar
        moduleLabel="Mail"
        items={mailItems}
        ariaLabel="Navegação do Orbital Mail"
      />
      <main class:list={["app-main", { "dev-highlight-page": devOnly }]} data-orbital-dev-highlight={devOnly ? 'true' : undefined}><slot /></main>
    </div>
  </div>
  <script is:inline set:html={orbitalMailAuthScript}></script>
</body>
</html>
