DB_PROVIDER=oracle
DB_SQL_ECHO=false
ORACLE_CALL_TIMEOUT_MS=15000
ORACLE_CONNECT_RECOVERY_ATTEMPTS=1
ORACLE_CONNECT_RETRY_COUNT=1
ORACLE_CONNECT_RETRY_DELAY_SECONDS=1
ORACLE_CONNECT_STRING=sindicatto_tp
ORACLE_CURRENT_SCHEMA=WKSP_SINDICATTO
ORACLE_EXPIRE_TIME_MINUTES=2
ORACLE_PASSWORD=********
ORACLE_POOL_MAX_OVERFLOW=4
ORACLE_POOL_PRE_PING=true
ORACLE_POOL_RECYCLE_SECONDS=1800
ORACLE_POOL_SIZE=2
ORACLE_POOL_TIMEOUT_SECONDS=5
ORACLE_POOL_USE_LIFO=true
ORACLE_POOL_WARN_CHECKOUT_SECONDS=5
ORACLE_TCP_CONNECT_TIMEOUT_SECONDS=5
ORACLE_USER=WKSP_SINDICATTO
ORACLE_WALLET_DIR=/home/ubuntu/.oracle/Wallet_sindicatto
ORACLE_WALLET_PASSWORD=********
