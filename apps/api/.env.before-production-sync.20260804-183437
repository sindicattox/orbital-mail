# Orbital Mail API — configuração independente.
APP_NAME="Orbital Mail API"
APP_SERVICE=orbital-mail-api
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8106
# CORS em CSV simples, sem colchetes e sem aspas.
APP_CORS_ORIGINS=https://email.anpprev.org,https://admin.anpprev.org

# -----------------------------------------------------------------------------
# AUTENTICAÇÃO
# -----------------------------------------------------------------------------
# Standalone local: usa EXATAMENTE os três fallbacks abaixo.
AUTH_MODE=standalone
AUTH_DEV_TENANT_CODE=anpprev
AUTH_DEV_USER_ID=1
AUTH_DEV_IS_ADMIN=true

# Conectado ao orbital-app: altere apenas AUTH_MODE para remote e configure o
# SSO já existente no Orbital. O tenant NÃO vem do env; vem da identidade SSO.
AUTH_AUTHORIZE_URL=https://admin.anpprev.org/auth/sso/authorize
AUTH_TOKEN_URL=http://127.0.0.1:8001/auth/sso/token
AUTH_CLIENT_ID=email-app
AUTH_CLIENT_SECRET=f9f18e18486510b626a2e3d27529867cebef072e505ca959fcc6bf24576508f8
AUTH_REDIRECT_URI=https://email.anpprev.org/api/mail/auth/callback
AUTH_WEB_URL=https://email.anpprev.org/
AUTH_SESSION_SECRET=troque-por-uma-chave-longa-exclusiva-do-orbital-mail
AUTH_COOKIE_NAME=orbital_mail_session
AUTH_COOKIE_SECURE=true
AUTH_SESSION_TTL_SECONDS=28800
AUTH_TIMEOUT_SECONDS=5

# Compatibilidade opcional com proxy legado de contexto Bearer. Não é usado no
# fluxo SSO normal do orbital-app atual.
AUTH_CONTEXT_URL=

# Oracle — bloco comum, copiável sem renomear.
ORACLE_USER=WKSP_SINDICATTO
ORACLE_PASSWORD=(23)bqns_!?OE?!
ORACLE_CONNECT_STRING=sindicatto_tp
ORACLE_WALLET_LOCAL_DIR=/home/daniel/.oracle/Wallet_sindicatto
ORACLE_WALLET_REMOTE_DIR=/home/ubuntu/.oracle/Wallet_sindicatto
ORACLE_WALLET_PASSWORD=(23)bqns_!?OE?!
ORACLE_CURRENT_SCHEMA=WKSP_SINDICATTO
ORACLE_POOL_SIZE=3
ORACLE_POOL_MAX_OVERFLOW=2
ORACLE_POOL_TIMEOUT_SECONDS=10
ORACLE_POOL_RECYCLE_SECONDS=300
ORACLE_POOL_PRE_PING=true
ORACLE_POOL_USE_LIFO=true
DB_SQL_ECHO=false

# Entrega de e-mail exclusiva desta API.
EMAIL_PROVIDER=smtp2go
EMAIL_SEND_ENABLED=false
