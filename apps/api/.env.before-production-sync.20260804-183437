SMTP_PORT=465
SMTP_USERNAME="suporte@sindicatto.com"
SMTP_PASSWORD=
SMTP_SECURITY=tls

# Imagens públicas separadas automaticamente pelo tenant autenticado.
# O caminho público é CANÔNICO e obrigatório: /api/mail/uploads.
# Não use /uploads/mail: a API recusa iniciar com essa configuração incorreta.
EMAIL_UPLOAD_DIR=/home/ubuntu/storage/tenants/{tenant}/media/email_campaign
EMAIL_UPLOAD_PUBLIC_URL=https://email.anpprev.org/api/mail/uploads
# Produção: EMAIL_UPLOAD_PUBLIC_URL=https://email.seudominio.org/api/mail/uploads
EMAIL_UPLOAD_MAX_BYTES=5242880

EMAIL_WORKER_DELAY_MS=200
EMAIL_WORKER_MAX_ATTEMPTS=3
EMAIL_TEST_MAX_WORKERS=5
EMAIL_TEST_MAX_RECIPIENTS=100
EMAIL_TEST_MAX_REPETITIONS=5
EMAIL_TEST_MAX_MESSAGES=300
