# Orbital Mail API — configuração independente.
APP_NAME="Orbital Mail API"
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8104
CORS_ORIGINS="http://localhost:4102,http://127.0.0.1:4102,http://localhost:4001,http://127.0.0.1:4001"

# Contrato de autenticação compartilhado. Em produção use remote.
AUTH_MODE=disabled
AUTH_CONTEXT_URL=http://127.0.0.1:8001/auth/context
AUTH_TIMEOUT_SECONDS=5
AUTH_DEV_TENANT_CODE=anpprev
AUTH_DEV_USER_ID=1
AUTH_DEV_IS_ADMIN=true

# Oracle — bloco comum, copiável sem renomear.
ORACLE_USER=WKSP_SINDICATTO
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=sindicatto_tp
ORACLE_WALLET_LOCAL_DIR=/home/daniel/.oracle/Wallet_sindicatto
ORACLE_WALLET_REMOTE_DIR=/home/ubuntu/.oracle/Wallet_sindicatto
ORACLE_WALLET_PASSWORD=
ORACLE_CURRENT_SCHEMA=WKSP_SINDICATTO
ORACLE_POOL_SIZE=3
ORACLE_POOL_MAX_OVERFLOW=2
ORACLE_POOL_TIMEOUT_SECONDS=10
ORACLE_POOL_RECYCLE_SECONDS=300
ORACLE_POOL_PRE_PING=true
DB_SQL_ECHO=false

# Entrega de e-mail exclusiva desta API.
EMAIL_PROVIDER=disabled
EMAIL_SEND_ENABLED=false
EMAIL_FROM_NAME="Orbital Mail"
EMAIL_FROM_ADDRESS="suporte@sindicatto.com"
EMAIL_REPLY_TO="suporte@sindicatto.com"
EMAIL_SEND_TIMEOUT_SECONDS=30
SMTP2GO_API_KEY=
SMTP2GO_API_URL=https://api.smtp2go.com/v3/email/send
SMTP_HOST="smtp.mail.us-east-1.awsapps.com"
SMTP_PORT=465
SMTP_USERNAME="suporte@sindicatto.com"
SMTP_PASSWORD=
SMTP_SECURITY=tls
EMAIL_UPLOAD_DIR="/home/daniel/Code/data/orbital-mail/uploads"
EMAIL_UPLOAD_PUBLIC_URL=http://127.0.0.1:8104/uploads/mail
EMAIL_UPLOAD_MAX_BYTES=5242880
EMAIL_WORKER_DELAY_MS=200
EMAIL_WORKER_MAX_ATTEMPTS=3
EMAIL_TEST_MAX_WORKERS=5
EMAIL_TEST_MAX_RECIPIENTS=100
EMAIL_TEST_MAX_REPETITIONS=5
EMAIL_TEST_MAX_MESSAGES=300
