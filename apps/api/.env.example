# Orbital Mail API — configuração independente.
APP_NAME="Orbital Mail API"
APP_SERVICE=orbital-mail-api
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8104
# CORS em CSV simples, sem colchetes e sem aspas.
APP_CORS_ORIGINS=http://localhost:4104,http://127.0.0.1:4104,http://localhost:4001,http://127.0.0.1:4001

# -----------------------------------------------------------------------------
# AUTENTICAÇÃO — mesmo contrato do orbital-reports
# -----------------------------------------------------------------------------
# standalone: usa exclusivamente os três fallbacks abaixo.
# remote: exige token da sessão Orbital e consulta AUTH_CONTEXT_URL.
AUTH_MODE=standalone
AUTH_CONTEXT_URL=http://127.0.0.1:8001/auth/context
AUTH_TIMEOUT_SECONDS=5
AUTH_DEV_TENANT_CODE=anpprev
AUTH_DEV_USER_ID=1
AUTH_DEV_IS_ADMIN=true

# Oracle — bloco comum, copiável sem renomear.
ORACLE_USER=WKSP_SINDICATTO
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=sindicatto_tp
ORACLE_WALLET_LOCAL_DIR=/home/daniel/.oracle/Wallet_sindicatto
ORACLE_WALLET_REMOTE_DIR=/home/ubuntu/.oracle/Wallet_sindicatto
ORACLE_WALLET_PASSWORD=
ORACLE_CURRENT_SCHEMA=WKSP_SINDICATTO
ORACLE_POOL_SIZE=3
ORACLE_POOL_MAX_OVERFLOW=2
ORACLE_POOL_TIMEOUT_SECONDS=10
ORACLE_POOL_RECYCLE_SECONDS=300
ORACLE_POOL_PRE_PING=true
ORACLE_POOL_USE_LIFO=true
DB_SQL_ECHO=false

# Entrega de e-mail exclusiva desta API.
EMAIL_PROVIDER=disabled
EMAIL_SEND_ENABLED=false
EMAIL_FROM_NAME="Orbital Mail"
EMAIL_FROM_ADDRESS="suporte@sindicatto.com"
EMAIL_REPLY_TO="suporte@sindicatto.com"
EMAIL_SEND_TIMEOUT_SECONDS=30
SMTP2GO_API_KEY=
SMTP2GO_API_URL=https://api.smtp2go.com/v3/email/send
SMTP_HOST="smtp.mail.us-east-1.awsapps.com"
SMTP_PORT=587
SMTP_USERNAME="suporte@sindicatto.com"
SMTP_PASSWORD=
SMTP_SECURITY=tls

# Imagens públicas separadas automaticamente pelo tenant autenticado.
# O caminho público é CANÔNICO e obrigatório: /api/mail/uploads.
# Não use /uploads/mail: a API recusa iniciar com essa configuração incorreta.
EMAIL_UPLOAD_DIR="/home/daniel/storage/tenants/{tenant}/media/email_campaign"
EMAIL_UPLOAD_PUBLIC_URL=http://127.0.0.1:8104/api/mail/uploads
# Produção: EMAIL_UPLOAD_PUBLIC_URL=https://email.seudominio.org/api/mail/uploads
EMAIL_UPLOAD_MAX_BYTES=5242880

EMAIL_WORKER_DELAY_MS=200
EMAIL_WORKER_MAX_ATTEMPTS=3
EMAIL_TEST_MAX_WORKERS=5
EMAIL_TEST_MAX_RECIPIENTS=100
EMAIL_TEST_MAX_REPETITIONS=5
EMAIL_TEST_MAX_MESSAGES=300

# URL pública da interface usada nos links de descadastro.
MAIL_PUBLIC_URL=http://127.0.0.1:4106
# Gere uma chave longa e exclusiva por ambiente. Não compartilhe entre instalações.
MAIL_UNSUBSCRIBE_SECRET=
