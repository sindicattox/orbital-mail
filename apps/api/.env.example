APP_NAME="Orbital Mail API"
APP_ENV=development
APP_HOST="0.0.0.0"
APP_PORT="8102"
CORS_ORIGINS="http://localhost:4102,http://127.0.0.1:4102,http://localhost:4001,http://127.0.0.1:4001"

# Banco Oracle usado pelo módulo.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=localhost:1521/FREEPDB1
ORACLE_WALLET_LOCAL_DIR=
ORACLE_WALLET_REMOTE_DIR=
ORACLE_WALLET_PASSWORD=
ORACLE_CURRENT_SCHEMA=WKSP_SINDICATTO
ORACLE_POOL_SIZE=3
ORACLE_POOL_MAX_OVERFLOW=2
ORACLE_POOL_TIMEOUT_SECONDS=10
ORACLE_POOL_RECYCLE_SECONDS=300
ORACLE_POOL_PRE_PING=true
ORACLE_SQL_ECHO=false

# Autenticação.
# Produção/integrado ao Orbital: AUTH_MODE=remote e o tenant vem da sessão autenticada.
# Desenvolvimento local independente: AUTH_MODE=disabled e o tenant vem de DEV_TENANT_CODE.
AUTH_MODE=disabled
DEV_TENANT_CODE=anpprev
DEV_USER_ID=1
DEV_IS_ADMIN=true
ORBITAL_AUTH_CONTEXT_URL=http://127.0.0.1:8001/auth/context
AUTH_TIMEOUT_SECONDS=5

# Envio bloqueado por padrão. Para a tela de teste funcionar, altere explicitamente
# MAIL_SEND_ENABLED=true no ambiente local e reinicie a API.
MAIL_PROVIDER=disabled
MAIL_SEND_ENABLED=false
MAIL_FROM_NAME="Orbital Mail"
MAIL_FROM_ADDRESS=
MAIL_REPLY_TO=
MAIL_SEND_TIMEOUT_SECONDS=30

# SMTP2GO via API HTTPS.
SMTP2GO_API_KEY=
SMTP2GO_API_URL=https://api.smtp2go.com/v3/email/send

# SMTP tradicional. SMTP_SECURITY aceita: none, tls ou ssl.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=tls

# Caminho físico persistente, fora do código e do deploy.
MAIL_UPLOAD_DIR=/home/daniel/Code/data/orbital-mail/uploads

# Localmente serve para preview. No servidor deve ser uma URL HTTPS pública,
# acessível pelo Gmail/Outlook quando o destinatário abrir a mensagem.
MAIL_PUBLIC_UPLOAD_URL=http://127.0.0.1:8102/uploads/mail
MAIL_UPLOAD_MAX_BYTES=5242880

# Teste controlado de loop/concorrência.
MAIL_WORKER_DELAY_MS=200
MAIL_WORKER_MAX_ATTEMPTS=3
MAIL_TEST_MAX_WORKERS=5
MAIL_TEST_MAX_RECIPIENTS=100
MAIL_TEST_MAX_REPETITIONS=5
MAIL_TEST_MAX_MESSAGES=300
