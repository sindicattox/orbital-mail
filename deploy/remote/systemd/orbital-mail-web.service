[Unit]
Description=orbital-mail Web Astro
After=network.target orbital-mail-api.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/orbital-mail/apps/web
EnvironmentFile=/home/ubuntu/apps/orbital-mail/apps/web/.env
ExecStart=/usr/bin/env HOST=${APP_HOST} PORT=${APP_PORT} /usr/bin/node /home/ubuntu/apps/orbital-mail/apps/web/dist/server/entry.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
