[Unit]
Description=orbital-mail API FastAPI
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/orbital/orbital-mail/apps/api
EnvironmentFile=/home/ubuntu/apps/orbital/orbital-mail/apps/api/.env
ExecStart=/home/ubuntu/apps/orbital/orbital-mail/apps/api/.venv/bin/uvicorn main:app --host ${APP_HOST} --port ${APP_PORT}
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
