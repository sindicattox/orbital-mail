[Unit]
Description=orbital-mail API FastAPI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/orgs/orbital/orbital-mail/apps/api
EnvironmentFile=/home/ubuntu/apps/orgs/orbital/orbital-mail/apps/api/.env
ExecStart=/home/ubuntu/apps/orgs/orbital/orbital-mail/apps/api/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8106 --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
